# Public production origins. HTTPS only, no path/query/fragment.
ELF_PUBLIC_ORIGIN=https://forum.example.com
ELF_ADMIN_ORIGIN=https://admin.example.com
ELF_API_ORIGIN=https://api.example.com

# PostgreSQL origin used only by local migration/admin/Hyperdrive setup commands.
# Keep this file local; .env.production is gitignored.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/adoforum?sslmode=require

# Leave empty on first setup to let `npm run production:setup` create Hyperdrive.
ELF_HYPERDRIVE_ID=
ELF_HYPERDRIVE_NAME=enhanced-level-forum-db

# Required Worker secret. Use a long random value, not a password you reuse elsewhere.
AUTH_RATE_LIMIT_SALT=

# Initial production administrator. The password is never passed in argv.
ELF_ADMIN_EMAIL=admin@example.com
ELF_ADMIN_NAME=ELF Administrator
ELF_ADMIN_PASSWORD=
