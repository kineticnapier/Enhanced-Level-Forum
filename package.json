{
  "name": "enhanced-level-forum",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:web": "npm -w @elf/web run dev",
    "dev:admin": "npm -w @elf/admin run dev",
    "build": "npm run build:shared && npm run build:api && npm run build:web && npm run build:admin",
    "build:shared": "npm -w @elf/shared run build",
    "build:api": "npm -w @elf/api run build",
    "build:web": "npm -w @elf/web run build",
    "build:admin": "npm -w @elf/admin run build",
    "deploy:api": "npm -w @elf/api run deploy",
    "deploy:web": "npm -w @elf/web run deploy",
    "deploy:admin": "npm -w @elf/admin run deploy",
    "production:setup": "node scripts/setup-production.mjs",
    "production:deploy": "node scripts/deploy-production.mjs",
    "production:smoke": "node scripts/smoke-production.mjs",
    "production:reset-admin": "node scripts/reset-production-admin.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "auth:create-admin": "node scripts/create-admin.mjs",
    "import:tuf": "node scripts/import-tuf.mjs",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-public.mjs && node scripts/smoke-auth.mjs && node scripts/smoke-deploy.mjs && node scripts/smoke-i18n.mjs",
    "test": "npm run build && npm run smoke",
    "test:e2e": "node scripts/e2e-smoke.mjs && node scripts/e2e-tuf-reconciliation.mjs && node scripts/e2e-tuf-evidence.mjs && node scripts/e2e-proposal-execution.mjs && node scripts/e2e-reference-proposals.mjs && node scripts/e2e-tuf-create-level.mjs && node scripts/e2e-public-governance.mjs && node scripts/e2e-production-auth.mjs",
    "test:e2e:reconciliation": "node scripts/e2e-tuf-reconciliation.mjs",
    "test:e2e:tuf-evidence": "node scripts/e2e-tuf-evidence.mjs",
    "test:e2e:proposal-execution": "node scripts/e2e-proposal-execution.mjs",
    "test:e2e:reference-proposals": "node scripts/e2e-reference-proposals.mjs",
    "test:e2e:tuf-create-level": "node scripts/e2e-tuf-create-level.mjs",
    "test:e2e:public-governance": "node scripts/e2e-public-governance.mjs",
    "test:e2e:production-auth": "node scripts/e2e-production-auth.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
